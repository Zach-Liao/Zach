function download_file(data, file_name) {
    const file = new Blob([data], { type: 'text/plain' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(file);
    link.download = file_name;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(link.href);
}

async function download_save(file0, file9, fileini, filename){
    const { default: JSZip } = await import('https://cdn.jsdelivr.net/npm/jszip@3.10.1/+esm');
    const zip = new JSZip();

    zip.file("file0", file0);
    zip.file("file9", file9);
    zip.file("undertale.ini", fileini);

    const zipBlob = await zip.generateAsync({ type: "blob" });

    const link = document.createElement('a');
    link.href = URL.createObjectURL(zipBlob);
    link.download = filename;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(link.href);
    
}[LLVM-OPERAGX]
EMSDKDir="c:/source/emsdk/emsdk.bat"
[OperaGX]
ProjectGuid=""
[ext_browser_download]
[WebUploaderBridge]
function gm_trigger_uploader() {
    const saveKey = "/_savedata/file0";
    const saveKey9 = "/_savedata/file9";
    const iniKey = "/_savedata/undertale.ini";

    // Avoid creating the overlay more than once.
    if (document.getElementById("gm_modern_upload_trigger")) {
        return 0;
    }

    const style = document.createElement('style');
    style.textContent = `
        #gm_modern_upload_trigger {
            position: fixed;
            inset: 0;
            z-index: 999999;
            background: #000;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: monospace;
            padding: 20px;
            box-sizing: border-box
        }
        #gm_panel_holder{
            width: 100%;
            max-width: 460px;
            border: 2px solid white;
            padding: 24px;
            box-sizing: border-box;
            background: #111
        }
        .gm_input_label{
            display:block;margin-top:20px;
        }
        .gm_input{
        display:block;
        width:100%;margin-top:8px
        }
        .gm_divider{border-top:1.5px dashed #f4f6f6}
        
        .gm_button{
            width:100%;padding:12px;margin-top:8px;
            background:#222;color:white;border:2px solid white;
            cursor:pointer}
    `;

    document.head.appendChild(style)

    const overlay = document.createElement("div");
    overlay.id = "gm_modern_upload_trigger";



    const panel = document.createElement("div");
    panel.id = "gm_panel_holder"



    panel.innerHTML = `
        <h2 style="text-align:center;letter-spacing:4px">
            UNDERTALE
        </h2>

        <p>No save data found.</p>
        <p>Select your existing save files or start a new game.</p>

        <label class="gm_input_label" for="gm-file0">
            Main Save (file0)
        </label>
        <input class="gm_input" id="gm-file0" type="file">

        <label class="gm_input_label" for="gm-ini">
            Configuration (undertale.ini)
        </label>
        <input class="gm_input" id="gm-ini" type="file" accept=".ini,.txt">

        <label class="gm_input_label" for="gm-file9">
            Backup Save (file9)
        </label>
        <input class="gm_input" id="gm-file9" type="file">

        <hr class="gm_divider">
        <div style="text-align:center"><span>OR</span></div>
        <hr class="gm_divider">

        <label class="gm_input_label" for="gm-zip">
            Bundled (utSave.zip) !!!Doesn't work yet
        </label>
        <input class="gm_input" id="gm-zip" type="file" accept=".zip">

        <p id="gm-upload-status" role="status">
            Select both files to import your save.
        </p>

        <button class="gm_button" id="gm-import-button" type="button" disabled>
            IMPORT SAVES
        </button>

        <button class="gm_button" id="gm-skip-button" type="button">
            NEW GAME ‚Äî SKIP IMPORT
        </button>
    `;

    overlay.appendChild(panel);
    document.body.appendChild(overlay);

    const file0Input = panel.querySelector("#gm-file0");
    const iniInput = panel.querySelector("#gm-ini");
    const file9Input = panel.querySelector("#gm-file9");
    const zipInput = panel.querySelector("#gm-zip");

    const importButton = panel.querySelector("#gm-import-button");
    const skipButton = panel.querySelector("#gm-skip-button");
    const status = panel.querySelector("#gm-upload-status");

    function updateStatus() {
        const file0 = file0Input.files[0];
        const ini = iniInput.files[0];
        


        const validFile0 = file0 && file0.name === "file0";
        const validIni = ini &&
            ini.name.toLowerCase() === "undertale.ini";

        importButton.disabled = !(validFile0 && validIni);

        if (validFile0 && validIni) {
            status.textContent = "Both files ready to import.";
        } else {
            status.textContent =
                "Select file0 and undertale.ini to import your save.";
        }
    }

    file0Input.addEventListener("change", updateStatus);
    iniInput.addEventListener("change", updateStatus);

    importButton.addEventListener("click", async function() {
        const file0 = file0Input.files[0];
        const ini = iniInput.files[0];

        if (
            !file0 ||
            file0.name !== "file0" ||
            !ini ||
            ini.name.toLowerCase() !== "undertale.ini"
        ) {
            status.textContent = "Please select both correct files.";
            return;
        }

        importButton.disabled = true;
        skipButton.disabled = true;
        status.textContent = "Importing save data...";

        let db;

        try {
            const file9 = file9Input.files[0];
            // Read both files.
            const [saveText, iniText, save9Text] = await Promise.all([
                file0.text(),
                ini.text(),
                file9 ? file9.text() : Promise.resolve(null)
            ]);

            const filesToSave = [[saveText, saveKey], [iniText, iniKey]];
            if (save9Text !== null) {
                filesToSave.push([save9Text, saveKey9])
            }

            const encoder = new TextEncoder();

            // Open the database and wait for it to finish opening.
            db = await new Promise((resolve, reject) => {
                const req = indexedDB.open("/_savedata");

                req.onsuccess = () => resolve(req.result);
                req.onerror = () => reject(req.error);

                req.onblocked = () => {
                    reject(new Error("Database opening was blocked."));
                };
            });

            // Make sure the expected object store exists.
            if (!db.objectStoreNames.contains("FILE_DATA")) {
                throw new Error(
                    'IndexedDB object store "FILE_DATA" was not found.'
                );
            }

            // Write both files in one transaction.
            const tx = db.transaction("FILE_DATA", "readwrite");
            const store = tx.objectStore("FILE_DATA");

            filesToSave.forEach(([contents, key]) => {
                store.put({
                    timestamp: new Date(),
                    mode: 33206,
                    contents: encoder.encode(contents)
                }, key);
            });

            // Wait until the transaction has actually finished.
            await new Promise((resolve, reject) => {
                tx.oncomplete = resolve;

                tx.onerror = () => {
                    reject(tx.error || new Error("Save transaction failed."));
                };

                tx.onabort = () => {
                    reject(tx.error || new Error("Save transaction aborted."));
                };
            });

            // Only reload after both writes have completed.
            db.close();
            db = null;

            status.textContent = "Save imported. Reloading...";
            location.reload();

        } catch (error) {
            console.error("Undertale save import failed:", error);

            status.textContent =
                "Import failed. Check the database schema and browser storage.";

            importButton.disabled = false;
            skipButton.disabled = false;

        } finally {
            if (db) {
                db.close();
            }
        }
    });

    skipButton.addEventListener("click", function() {
        localStorage.setItem("undertale_skip_import", "1");
        location.reload();
    });

    return 0;
}

function gm_should_skip_import() {
    return localStorage.getItem("undertale_skip_import") === "1" ? 1 : 0;
}